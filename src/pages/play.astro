---
// The play page has been retired. Its address now leads to the work index.
import { url } from '../lib/data'

const to = url('work/')
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Moved · Joshua Bugarin</title>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, Astro.site)} />
  </head>
  <body>
    <p>This page has moved to <a href={to}>the work index</a>.</p>
  </body>
</html>
