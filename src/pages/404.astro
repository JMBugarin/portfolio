---
import { href, site } from '../data/site'
import Base from '../layouts/Base.astro'
---

<Base title={`Not found · ${site.name}`} description="This page is not on the mat.">
  <article class="lay">
    <div class="tech-sheet">
      <span class="tape mat-only" aria-hidden="true"></span>
      <p class="card-fig">Error 404</p>
      <h1 class="card-title">Nothing pinned here.</h1>
      <p class="card-desc">The page you asked for isn't on the mat. It may have moved, or the link has a typo.</p>
      <p class="card-links"><a href={href()}>Back to the portfolio <span aria-hidden="true">→</span></a></p>
    </div>
  </article>
</Base>
