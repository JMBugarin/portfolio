---
import Base from '../layouts/Base.astro'
import { url } from '../lib/data'
---
<Base title="Not found · Joshua Bugarin" description="This page does not exist.">
  <section class="lost">
    <span class="mini-deck" aria-hidden="true"><svg viewBox="0 0 240 400"><use href="#deck-back" /></svg></span>
    <p class="eyebrow">404</p>
    <h1>That page is not in the deck.</h1>
    <p class="lede">The address may be old or mistyped. Everything on this site is one step from here.</p>
    <div class="row">
      <a class="btn primary" href={url('')}>Back to the start</a>
      <a class="btn" href={url('work/')}>Work index</a>
    </div>
  </section>
</Base>
