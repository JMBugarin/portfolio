---
import Figure from '../../components/Figure.astro'
import { Gallery } from '../../components/Gallery'
import Base from '../../layouts/Base.astro'
import { projects, url, verifiedOn, type Project } from '../../lib/data'

// One template for every project. A section with nothing to say is left out.
export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }))
}
interface Props { project: Project }
const { project: p } = Astro.props
const at = projects.findIndex((x) => x.id === p.id)
const previous = projects[(at - 1 + projects.length) % projects.length]
const next = projects[(at + 1) % projects.length]
const hasMedia = p.media.length > 0 || p.captures.length > 0
const hasOutcome = !!p.stat || p.results.length > 0 || !!p.lesson || p.limits.length > 0
---
<Base title={`${p.name} · Joshua Bugarin`} description={p.summary} current="work">
  <article class="reading project">
    <header class="project-head">
      <a class="back" href={url('work/')}>All work</a>
      <span class="mini-deck" aria-hidden="true"><svg viewBox="0 0 240 400"><use href="#deck-back" /></svg></span>
      <p class="eyebrow">{p.category} · Project {at + 1} of {projects.length}</p>
      <h1>{p.name}</h1>
      <p class="lede">{p.summary}</p>
      <dl class="meta">
        <div><dt>Role</dt><dd>{p.role}</dd></div>
        {p.dates && <div><dt>Dates</dt><dd>{p.dates}</dd></div>}
        {p.status && <div><dt>Status</dt><dd>{p.status}</dd></div>}
        {p.stack.length > 0 && <div><dt>Built with</dt><dd><ul class="tags">{p.stack.map((t) => <li>{t}</li>)}</ul></dd></div>}
      </dl>
      <ul class="project-links">
        {p.source && <li><a class="btn primary ext" href={p.source.url}>Source on GitHub</a><span class="muted">{p.source.label}, at commit <code>{p.source.commit}</code></span></li>}
        {p.links.map((l) => <li><a class="btn ext" href={l.url}>{l.label}</a>{l.note && <span class="muted">{l.note}</span>}</li>)}
        {!p.source && p.sealed && <li><span class="muted">{p.sealed}</span></li>}
      </ul>
    </header>

    {(p.problem || p.built || p.contribution) && (
      <section aria-labelledby="overview">
        <h2 id="overview"><span class="edges" aria-hidden="true"></span>Overview</h2>
        {p.problem && <div class="part"><h3>The problem</h3><p>{p.problem}</p></div>}
        {p.built && (
          <div class="part">
            <h3>{p.team ? 'What the team built' : 'What I built'}</h3>
            <p>{p.built}</p>
            {p.parts.length > 0 && <ol class="steps">{p.parts.map((s) => <li><h4>{s.title}</h4><p>{s.body}</p></li>)}</ol>}
          </div>
        )}
        {p.contribution && (
          <div class="part">
            <h3>My contribution</h3>
            <p>{p.contribution}</p>
            {p.contributionNote && <p class="muted">{p.contributionNote}</p>}
          </div>
        )}
      </section>
    )}

    {hasMedia && (
      <section aria-labelledby="media">
        <h2 id="media"><span class="edges" aria-hidden="true"></span>Media</h2>
        {p.media.map((m) => <Figure media={m} />)}
        {p.captures.length > 0 && (
          <div class="part">
            <h3>More captures</h3>
            <p class="muted">{p.captures.length} more from the running software. Each one opens with a note on how it was made.</p>
            <Gallery client:visible captures={p.captures} label={`${p.name} captures`} />
          </div>
        )}
      </section>
    )}

    {p.decisions.length > 0 && (
      <section aria-labelledby="decisions">
        <h2 id="decisions"><span class="edges" aria-hidden="true"></span>Engineering decisions</h2>
        <ol class="decisions">
          {p.decisions.map((d) => (
            <li>
              <h3>{d.title}</h3>
              <dl>
                <div><dt>I chose</dt><dd>{d.choice}</dd></div>
                <div><dt>The tradeoff</dt><dd>{d.tradeoff}</dd></div>
              </dl>
            </li>
          ))}
        </ol>
      </section>
    )}

    {hasOutcome && (
      <section aria-labelledby="outcome">
        <h2 id="outcome"><span class="edges" aria-hidden="true"></span>Outcome and limitations</h2>
        {p.stat && (
          <p class="stat">
            <b>{p.stat.value}<small>{p.stat.unit}</small></b>
            <span><strong>{p.stat.label}.</strong> {p.stat.source}</span>
          </p>
        )}
        {p.lesson && <div class="part"><h3>What I learned</h3><p>{p.lesson}</p></div>}
        {p.results.length > 0 && (
          <div class="part">
            <h3>Results</h3>
            <ul class="results">
              {p.results.map((r) => (
                <li>
                  <p>{r.claim}</p>
                  <p class="source">Source: <code>{r.source}</code>. {r.rerun ? `I re-ran this on ${verifiedOn}.` : 'From the repository; not re-run.'}</p>
                </li>
              ))}
            </ul>
            {p.table && (
              <details class="table-box">
                <summary>Show the full table</summary>
                <div class="table-scroll" tabindex="0" role="group" aria-label={p.table.caption}>
                  <table>
                    <caption>{p.table.caption}</caption>
                    <thead><tr>{p.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                    <tbody>{p.table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
                  </table>
                </div>
                <p class="muted">{p.table.note}</p>
              </details>
            )}
          </div>
        )}
        {p.limits.length > 0 && <div class="part"><h3>Limits</h3><ul class="limits">{p.limits.map((l) => <li>{l}</li>)}</ul></div>}
        {p.sources.length > 0 && <div class="part"><h3>Read more</h3><ul class="sources">{p.sources.map((l) => <li><a class="link ext" href={l.url}>{l.label}</a></li>)}</ul></div>}
      </section>
    )}

    <nav class="pager" aria-label="More projects">
      <div class="pager-row breakout">
        <a href={url(`work/${previous.id}/`)}><span>Previous project</span><b>{previous.name}</b></a>
        <a href={url(`work/${next.id}/`)}><span>Next project</span><b>{next.name}</b></a>
      </div>
    </nav>
  </article>
</Base>
