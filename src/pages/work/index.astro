---
import Base from '../../layouts/Base.astro'
import { projects, url } from '../../lib/data'
---
<Base title="Work · Joshua Bugarin" description="Pacer, TileLens and Classmap, each with its numbers and its limits, plus Ethocal, a team project." current="work">
  <div class="page">
    <header class="page-head">
      <p class="eyebrow">Work</p>
      <h1>Three solo projects and one team project.</h1>
      <p class="lede">Each opens into the same short write-up: what it is, what I built, the decisions and what held up. The team project comes last, where the code is not mine to show.</p>
    </header>

    <ol class="index">
      {projects.map((p) => (
        <li class="entry">
          <div class="entry-art">
            {p.cover
              ? <img src={p.cover.src} srcset={p.cover.srcset} sizes="(min-width: 46rem) 300px, 92vw" width={p.cover.width} height={p.cover.height} alt={p.cover.alt} style={`object-position:${p.cover.focus ?? '50% 50%'}`} loading="lazy" decoding="async" />
              : <p class="face-sealed"><svg viewBox="0 0 32 32" aria-hidden="true"><use href="#deck-mark" /></svg>{p.sealed}</p>}
          </div>
          <div class="entry-body">
            <p class="eyebrow">{p.category}</p>
            <h2><a href={url(`work/${p.id}/`)}>{p.name}</a></h2>
            <p>{p.summary}</p>
            {p.stat && <p class="entry-stat"><b>{p.stat.value} {p.stat.unit}</b> {p.stat.label}. <span class="muted">{p.stat.source}</span></p>}
            <p class="entry-meta muted">{[p.team ? '' : 'Solo project', p.dates, p.stack.slice(0, 4).join(', ')].filter(Boolean).join(' · ')}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>
