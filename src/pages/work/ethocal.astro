---
import Base from '../../layouts/Base.astro'
import { ethocal, ethocalStack, url } from '../../lib/data'
---
<Base title="Ethocal · Joshua Bugarin" description="Ethocal, a team Flutter app for sustainable shopping, and the parts Joshua built." current="work">
  <article class="case">
    <header class="case-hero">
      <div class="wrap">
        <a class="back" href={url('work/')}>All work</a>
        <p class="eyebrow">Ethocal · team project</p>
        <h1>A marketplace that argues with fast fashion.</h1>
        <p class="lede">{ethocal.note}</p>
        <ul class="tags" style="margin-top:18px">{ethocalStack.map((s) => <li>{s}</li>)}</ul>
      </div>
    </header>
    <div class="wrap">
      <section class="two">
        <div><p class="eyebrow">My part</p><h2>What I built.</h2></div>
        <div><p class="prose">{ethocal.contribution?.replace(/^Built/, 'I built')}</p></div>
      </section>
      <section class="two">
        <div><p class="eyebrow">What you can see</p><h2>Not much, honestly.</h2></div>
        <div><p class="prose muted">The repository is private and belongs to a teammate, so there is no code link, demo or measured result here. This page exists so the project is not left out, and so nothing about it is overstated.</p></div>
      </section>
    </div>
  </article>
</Base>
