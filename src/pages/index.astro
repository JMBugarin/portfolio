---
import Deck from '../components/Deck.astro'
import Base from '../layouts/Base.astro'
import { email, links, url } from '../lib/data'
---
<Base title="Joshua Bugarin · Software and AI/ML engineering" description="Joshua Bugarin studies computer science at UC Santa Cruz with a computer engineering minor, and builds small tools he can measure: Pacer, TileLens and Classmap." current="home">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Software and AI/ML engineering</p>
      <h1>Joshua Bugarin</h1>
      <p class="hero-intro">
        <b>Computer science at UC Santa Cruz, with a computer engineering minor.</b>{' '}
        I build systems that make better decisions: <a class="inline" href={url('work/pacer/')}>what an LLM cache keeps</a>, <a class="inline" href={url('work/tilelens/')}>which word wins the board</a> and <a class="inline" href={url('work/classmap/')}>where your next class actually is</a>. Then I check the work.
      </p>
      <div class="hero-actions">
        <a class="btn primary" href="#projects" data-deck-open>Browse projects</a>
        <a class="btn" href={url('work/')}>Work index</a>
        <ul class="hero-links">
          <li><a class="link" href={url(links.resume)}>Resume (PDF)</a></li>
          <li><a class="link" href={`mailto:${email}`}>Email</a></li>
          <li><a class="link" href={links.github}>GitHub</a></li>
          <li><a class="link" href={links.linkedin}>LinkedIn</a></li>
        </ul>
      </div>
    </div>
  </section>
  <Deck />
</Base>
