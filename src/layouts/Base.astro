---
import '@fontsource-variable/ibm-plex-sans/wght.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '@fontsource/instrument-serif/400.css'
import '@fontsource/instrument-serif/400-italic.css'
import '@fontsource-variable/caveat/wght.css'
import '@fontsource/gochi-hand/400.css'
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import ResumeViewer from '../components/ResumeViewer.astro'
import { href } from '../data/site'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
const ticksX = Array.from({ length: 10 }, (_, i) => i)
const ticksY = Array.from({ length: 40 }, (_, i) => i)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e9e5dc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <script is:inline>
      ;(function () {
        var view
        try {
          var asked = new URLSearchParams(location.search).get('view')
          if (asked === 'list' || asked === 'mat') localStorage.setItem('view', asked)
          view = localStorage.getItem('view')
        } catch (e) {}
        document.documentElement.dataset.view = view === 'list' ? 'list' : 'mat'
        document.documentElement.classList.add('intro')
      })()
    </script>
    <noscript><style>.view-toggle { display: none }</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" class="drafting-container">
      <div class="engineering-mat">
        <div class="ruler ruler-x mat-only" aria-hidden="true">
          {ticksX.map((i) => <span style={`left:${i * 160}px`}>{i * 5}</span>)}
        </div>
        <div class="ruler ruler-y mat-only" aria-hidden="true">
          {ticksY.map((i) => <span style={`top:${i * 160}px`}>{i * 5}</span>)}
        </div>
        <p class="mat-print mat-only" aria-hidden="true">Self-healing cutting mat · 1 sq = 1 cm · A1</p>
        <slot />
      </div>
    </main>
    <ResumeViewer />
    <script>
      import '../scripts/mat'
      import '../scripts/drag'
    </script>
  </body>
</html>
