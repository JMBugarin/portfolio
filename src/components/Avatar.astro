---
interface Props {
  class?: string
}
const { class: className } = Astro.props
const ink = '#151110'
const hair = '#2a1e19'
const skin = '#f3d4b8'
---

<svg class={className} viewBox="0 0 120 112" aria-hidden="true" fill="none" stroke={ink} stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
  <path d="M21 70C13 40 30 13 61 12c32-1 47 24 40 57-2 11-7 17-11 19H31c-5-2-9-8-10-18Z" fill={hair} />
  <ellipse cx="25.5" cy="72" rx="6" ry="8" fill={skin} />
  <ellipse cx="94.5" cy="72" rx="6" ry="8" fill={skin} />
  <path d="M28 63c0-18 14-27 32-27s32 9 32 27c0 23-14 37-32 37S28 86 28 63Z" fill={skin} />
  <g stroke="none" fill={ink}>
    <ellipse cx="47.5" cy="70.5" rx="4.2" ry="5.6" />
    <ellipse cx="72.5" cy="70.5" rx="4.2" ry="5.6" />
  </g>
  <g stroke="none" fill="#fff">
    <circle cx="46" cy="68.4" r="1.5" />
    <circle cx="71" cy="68.4" r="1.5" />
  </g>
  <g stroke-width="1.8" stroke="#8d939c">
    <path d="M35 66v7q0 6 6 6h12q6 0 6-6v-7" />
    <path d="M61 66v7q0 6 6 6h12q6 0 6-6v-7" />
    <path d="M59 64.5q1-2 2 0" />
  </g>
  <g stroke-width="4.6">
    <path d="M35 67v-3q0-4 4-4h16q4 0 4 4v3" />
