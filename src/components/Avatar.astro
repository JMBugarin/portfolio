  </g>
  <path d="M35 63.5 27 62M85 63.5 93 62" stroke-width="2.6" />
  <g stroke="none" fill="#f4a29a" opacity=".85">
    <ellipse cx="39" cy="85" rx="5" ry="2.4" />
    <ellipse cx="81" cy="85" rx="5" ry="2.4" />
  </g>
  <path d="M55.5 88.5q4.5 4 9 0" stroke-width="2.6" />
  <path
    d="M23 61C21 34 39 17 62 17c25 0 40 17 36 42l-7-9-3 11-7-13-5 12-6-14-5 13-6-13-5 12-5-11-4 11-5-10-3 11-5-9-3 10-2-8Z"
    fill={hair}
  />
  <path d="M58 18c1-9 10-14 18-11-7 2-9 6-9 11" fill={hair} stroke-width="2.6" />
</svg>
