---
import { sigil } from '../lib/arcana'
import { nav, url, type PageId } from '../lib/data'

interface Props { current?: PageId }
const { current } = Astro.props
---
<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href={url('')} aria-label="Joshua Bugarin, home">
      <Fragment set:html={sigil()} />
      Joshua Bugarin
    </a>
    <nav aria-label="Main">
      {nav.map((item) => <a href={url(item.path)} aria-current={current === item.id ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>
