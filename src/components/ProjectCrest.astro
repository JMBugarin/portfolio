---
interface Props { numeral: string; title: string; caption: string }
const { numeral, title, caption } = Astro.props
const symbols: Record<string, string> = { I: '✧', II: '☽', III: '✦', IV: '◇', V: '⋆', VI: '∞' }
---
<span class="tarot project-crest" aria-hidden="true">
  <svg viewBox="0 0 300 520" focusable="false">
    <rect width="300" height="520" rx="12" fill="var(--dusk)" />
    <rect x="10" y="10" width="280" height="500" rx="7" fill="none" stroke="var(--gold-deep)" />
    <rect x="19" y="19" width="262" height="482" rx="3" fill="none" stroke="var(--rule)" />
    <path d="M42 375V174Q42 96 150 72Q258 96 258 174V375Z" fill="none" stroke="var(--gold-deep)" />
    <path d="M50 375V176Q50 105 150 81Q250 105 250 176V375M42 352H258M42 363H258" fill="none" stroke="var(--rule)" />
    <path d="M65 236H235M150 151V321" stroke="var(--rule)" />
    <circle cx="150" cy="236" r="76" fill="none" stroke="var(--rule)" />
    <circle cx="150" cy="236" r="65" fill="none" stroke="var(--gold-deep)" />
    <text x="150" y="53" text-anchor="middle" fill="var(--gold)" font-family="var(--display)" font-size="24">{numeral}</text>
    <text x="150" y="259" text-anchor="middle" fill="var(--gold-pale)" font-family="Georgia, serif" font-size="78">{symbols[numeral] ?? '✧'}</text>
    <path d="M80 406H130M170 406H220M150 398L155 406L150 414L145 406Z" fill="none" stroke="var(--gold-deep)" />
    <text x="150" y="447" text-anchor="middle" fill="var(--bone)" font-family="var(--display)" font-size="18">{title}</text>
    <text x="150" y="478" text-anchor="middle" fill="var(--fog)" font-family="var(--body)" font-size="13">{caption}</text>
  </svg>
</span>
