---
import { href, site } from '../data/site'
const pdf = href(site.resume)
---

<dialog class="resume-viewer" aria-labelledby="resume-title" data-pdf={pdf}>
  <div class="resume-bar">
    <h2 id="resume-title">Résumé</h2>
    <a class="resume-action" href={pdf} download>Download</a>
    <button class="resume-close" type="button" aria-label="Close résumé">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9m0-9l-9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
  </div>
  <iframe title={`${site.name} résumé`} loading="lazy"></iframe>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.resume-viewer')!
  const frame = dialog.querySelector('iframe')!
  const pdf = dialog.dataset.pdf!

  function open(event: MouseEvent) {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-resume]')
    if (!link || event.button || event.metaKey || event.ctrlKey || event.shiftKey) return
    // phones have no inline PDF viewer; let the link open the file normally
    if (matchMedia('(max-width: 640px), (pointer: coarse)').matches) return
    event.preventDefault()
    if (!frame.getAttribute('src')) frame.src = `${pdf}#navpanes=0&view=FitH`
    dialog.showModal()
    document.documentElement.classList.add('resume-open')
  }
  document.addEventListener('click', open)
  dialog.querySelector('.resume-close')!.addEventListener('click', () => dialog.close())
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close()
  })
  dialog.addEventListener('close', () => document.documentElement.classList.remove('resume-open'))
</script>
