---
import type { Media } from '../lib/data'

interface Props { media: Media }
const { media: m } = Astro.props
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
const caption = m.caption && escape(m.caption).replace(/`([^`]+)`/g, '<code>$1</code>')
---
<figure class:list={['figure', 'breakout', { portrait: m.portrait }]}>
  <div class="frame" style={`aspect-ratio:${m.width}/${m.height}`}>
    {m.video
      ? <video controls preload="none" playsinline poster={m.src} aria-label={m.alt}><source src={m.video} type="video/mp4" /></video>
      : <img src={m.src} srcset={m.srcset} sizes="(min-width: 62rem) 58rem, 100vw" width={m.width} height={m.height} alt={m.alt} loading="lazy" decoding="async" />}
  </div>
  {caption && <figcaption set:html={caption} />}
</figure>
