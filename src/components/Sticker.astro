---
interface Props { value: string; unit: string; label: string }
const { value, unit, label } = Astro.props
const points = 18
const burst = Array.from({ length: points * 2 }, (_, i) => {
  const r = i % 2 ? 50 : 45.5
  const a = (i / (points * 2)) * Math.PI * 2
  return `${(50 + r * Math.cos(a)).toFixed(2)}% ${(50 + r * Math.sin(a)).toFixed(2)}%`
}).join(',')
---
<p class="sticker"><span style={`clip-path:polygon(${burst})`}><b>{value}<small>{unit}</small></b><i>{label}</i></span></p>
