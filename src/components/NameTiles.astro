---
// The name as a rack of letter tiles, a nod to TileLens. Shuffle it, then let the "solver" put it back.
const letters = [['J', 8], ['O', 1], ['S', 1], ['H', 4], ['U', 1], ['A', 1]] as const
const total = letters.reduce((n, [, v]) => n + v, 0)
---
<div class="rack">
  <div class="tiles solved" id="tiles" aria-hidden="true">
    {letters.map(([l, v], i) => <span class="tile" data-i={i} data-l={l}>{l}<i>{v}</i></span>)}
  </div>
  <p class="rack-note">
    <span id="rack-status">JOSHUA · {total} pts</span> ·
    <button type="button" id="shuffle" aria-describedby="rack-status">Shuffle the rack</button>
  </p>
</div>
<script define:vars={{ total }}>
  const box = document.getElementById('tiles'), status = document.getElementById('rack-status'), btn = document.getElementById('shuffle')
  const word = () => [...box.children].map((t) => t.dataset.l).join('')
  const show = () => {
    const solved = word() === 'JOSHUA'
    box.classList.toggle('solved', solved)
    status.textContent = solved ? `JOSHUA · ${total} pts` : `${word()} · not a word yet`
    btn.textContent = solved ? 'Shuffle the rack' : 'Find the best play'
  }
  btn.addEventListener('click', () => {
    const tiles = [...box.children]
    if (word() === 'JOSHUA') {
      do { tiles.sort(() => Math.random() - 0.5) } while (tiles.map((t) => t.dataset.l).join('') === 'JOSHUA')
    } else tiles.sort((a, b) => a.dataset.i - b.dataset.i)
    tiles.forEach((t) => box.append(t))
    show()
  })
</script>
