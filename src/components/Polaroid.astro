---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  src: ImageMetadata
  alt: string
  caption: string
  href: string
  class?: string
  tilt: number
  position?: string
}
const { src, alt, caption, href, class: className, tilt, position = 'center top' } = Astro.props
---

<a class:list={['polaroid', className]} href={href} style={`--r:${tilt}deg`} data-drag draggable="false">
  <span class="tape" aria-hidden="true"></span>
  <span class="polaroid-photo">
    <Image src={src} alt={alt} width={440} quality={78} loading="eager" draggable="false" style={`object-fit:cover;object-position:${position}`} />
  </span>
  <span class="polaroid-caption">{caption}</span>
</a>
